# Anthropic API キー（https://console.anthropic.com で取得）
ANTHROPIC_API_KEY=sk-ant-...

# Discord Bot Token（Discord Developer Portal で取得）
DISCORD_TOKEN=your-discord-token

# Discord アプリケーション ID（スラッシュコマンド登録に必要）
CLIENT_ID=

# ギルド限定コマンド（省略するとグローバル登録）
GUILD_ID=

# 使用モデル（デフォルト: claude-haiku-4-5）
# CLAUDE_MODEL=claude-haiku-4-5

# Claude Code CLI のパス（Linux=claude, Windows=フルパス）
# CLAUDE_PATH=claude

# 作業ディレクトリ
# WORK_DIR=/workspace

# 実行モード: true=全ツール許可
ALLOW_DANGEROUS_MODE=true

# 許可するツール（ALLOW_DANGEROUS_MODE=false の場合）
ALLOWED_TOOLS=Read,Write,Edit,Glob,Grep,Bash,LS

# 最大ターン数
# MAX_TURNS=30

# タイムアウト ms（0=無効）
# TIMEOUT_MS=0

# 同時実行上限
# MAX_CONCURRENT=3
